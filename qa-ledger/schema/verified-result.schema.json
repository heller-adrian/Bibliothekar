{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heller-adrian/Bibliothekar/qa-ledger/schema/verified-result.schema.json",
  "title": "Bibliothekar Verified QA Result",
  "type": "object",
  "required": [
    "schema_version",
    "product_version",
    "product_commit",
    "qa_commit",
    "phase",
    "test_id",
    "execution",
    "review",
    "evidence",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "product_version": {"type": "string"},
    "product_commit": {"type": "string"},
    "qa_commit": {"type": "string"},
    "phase": {"type": "string"},
    "test_id": {"type": "string"},
    "plan": {
      "type": ["object", "null"],
      "properties": {
        "task_id": {"type": "string"},
        "run_id": {"type": ["integer", "string"]}
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": ["task_id", "run_id"],
      "properties": {
        "task_id": {"type": "string"},
        "run_id": {"type": ["integer", "string"]},
        "profile": {"const": "nas-agent"}
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["task_id", "run_id", "profile", "judgment", "reason"],
      "properties": {
        "task_id": {"type": "string"},
        "run_id": {"type": ["integer", "string"]},
        "profile": {"const": "qa-thinker"},
        "judgment": {
          "enum": ["ACCEPT_PASS", "ACCEPT_FAIL", "ACCEPT_BLOCKED", "RETEST_REQUIRED"]
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "summary"],
        "properties": {
          "kind": {"type": "string"},
          "summary": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "recorded_at": {"type": "string"}
  },
  "additionalProperties": true
}
